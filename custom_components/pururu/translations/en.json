  "issues": {
    "automations_not_included": {
      "title": "The reactions' automations aren't loaded",
      "description": "pururu writes an automation for each reaction to `{file}`, but Home Assistant hasn't loaded them. Add this line to `configuration.yaml`:\n\n`{include}`\n\nThen reload automations in **Developer tools → YAML → Automations**, or restart Home Assistant."
    }
  },
