{
  "services": {
    "reload": {"service": "mdi:reload"}
  },
  "entity": {
    "binary_sensor": {
      "appliance_running": {"default": "mdi:stop-circle-outline", "state": {"on": "mdi:play-circle-outline"}}
    },
    "sensor": {
      "appliance_power": {"default": "mdi:flash"},
      "appliance_energy_total": {"default": "mdi:lightning-bolt"},
      "appliance_last_cycle_start": {"default": "mdi:clock-start"},
      "appliance_last_cycle_end": {"default": "mdi:clock-end"},
      "appliance_last_cycle_duration": {"default": "mdi:timer-outline"},
      "appliance_last_cycle_energy": {"default": "mdi:lightning-bolt-outline"},
      "appliance_cycles_total": {"default": "mdi:counter"},
      "appliance_runtime_total": {"default": "mdi:timer-sand"},
      "appliance_runtime_today": {"default": "mdi:timer-sand"},
      "appliance_runtime_week": {"default": "mdi:timer-sand"},
      "appliance_runtime_month": {"default": "mdi:timer-sand"},
      "appliance_runtime_year": {"default": "mdi:timer-sand"},
      "appliance_cycles_today": {"default": "mdi:counter"},
      "appliance_cycles_week": {"default": "mdi:counter"},
      "appliance_cycles_month": {"default": "mdi:counter"},
      "appliance_cycles_year": {"default": "mdi:counter"},
      "phase": {"default": "mdi:progress-clock"}
    }
  }
}
